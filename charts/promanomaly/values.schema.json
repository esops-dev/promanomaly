{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promanomaly.io/schemas/v1/values.schema.json",
  "title": "promanomaly chart values",
  "description": "Stable v1 schema. A future breaking change ships under a fresh $id (e.g. .../v2/values.schema.json) alongside a new apiVersion; this $id remains pinned to the v1 surface for the entire v1.x line.",
  "type": "object",
  "additionalProperties": true,
  "required": ["image", "datasource"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Replica count. Single-replica mode requires 1; bump only when highAvailability.enabled=true."
    },
    "highAvailability": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "lease_name": {"type": "string"},
        "lease_namespace": {"type": "string"},
        "lease_duration": {"type": "string"},
        "renew_deadline": {"type": "string"},
        "retry_period": {"type": "string"},
        "snapshot_ttl": {"type": "string"}
      }
    },
    "datasource": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "timeout": {"type": "string"},
        "auth": {
          "type": "object",
          "properties": {
            "type": {"type": "string", "enum": ["none", "bearer", "basic", "mtls"]},
            "existingSecret": {"type": "string"}
          }
        }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "listen": {"type": "string"},
        "refresh_interval": {"type": "string"}
      }
    },
    "safety": {
      "type": "object",
      "properties": {
        "max_series_per_query": {"type": "integer", "minimum": 1},
        "max_total_series": {"type": "integer", "minimum": 1},
        "series_overflow": {"type": "string", "enum": ["drop_lowest_priority", "reject", "sample"]},
        "on_source_failure": {"type": "string", "enum": ["serve_stale", "drop_scores", "fail_ready"]},
        "fail_ready_after": {"type": "integer", "minimum": 1},
        "query_cache": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "backend": {"type": "string", "enum": ["memory", "redis"]},
            "max_entries": {"type": "integer", "minimum": 1},
            "ttl": {"type": "string"}
          }
        },
        "redis": {
          "type": "object",
          "properties": {
            "url": {"type": "string"},
            "key_prefix": {"type": "string"},
            "timeout": {"type": "string"}
          }
        },
        "discovery": {
          "type": "object",
          "properties": {
            "forget_after_runs": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "warmup_policy": {
          "type": "string",
          "enum": ["emit_warming_up", "suppress", "emit_with_flag"]
        }
      }
    },
    "exporter": {
      "type": "object",
      "properties": {
        "output_labels": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "items": {"type": "string"}
            },
            "drop": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "otlp": {
          "type": "object",
          "properties": {
            "endpoint": {"type": ["string", "null"]},
            "insecure": {"type": "boolean"},
            "service_name": {"type": "string"}
          }
        }
      }
    },
    "groups": {"type": "array"},
    "existingConfigMap": {"type": "string"},
    "service": {"type": "object"},
    "serviceAccount": {"type": "object"},
    "resources": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "securityContext": {"type": "object"},
    "containerSecurityContext": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "serviceMonitor": {"type": "object"},
    "networkPolicy": {"type": "object"},
    "prometheusRule": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "namespace": {"type": "string"},
        "labels": {"type": "object"},
        "rules": {"type": "object"}
      }
    },
    "strategy": {"type": "object"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"}
  }
}
