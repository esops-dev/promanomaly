{
  "annotations": {"list": []},
  "editable": true,
  "schemaVersion": 38,
  "title": "promanomaly overview",
  "tags": ["promanomaly", "anomaly-detection"],
  "templating": {
    "list": [
      {
        "name": "group",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": "label_values(anomaly_score, group)",
        "refresh": 2,
        "multi": true,
        "includeAll": true
      },
      {
        "name": "id",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": "label_values(anomaly_score{group=~\"$group\"}, id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "anomaly_score",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "anomaly_score{group=~\"$group\", id=~\"$id\"}",
          "legendFormat": "{{detector}} {{id}}"
        }
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "anomaly_baseline vs. actual",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "anomaly_baseline{group=~\"$group\", id=~\"$id\"}",
          "legendFormat": "baseline {{id}}"
        }
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
    },
    {
      "id": 3,
      "type": "table",
      "title": "Top-N current anomalies",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "topk(10, anomaly_score{group=~\"$group\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
    }
  ]
}
